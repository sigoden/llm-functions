        "no_color": {
          "type": "boolean",
          "description": "Disable ANSI color output"
        },
        "verbose": {
          "type": "boolean",
          "description": "Enable detailed debug log output"
        }
      }
    }
  },
  {
    "name": "free_search",
    "description": "Performs fast, API-free web searches by parsing DuckDuckGo HTML and Lite endpoints with URL normalization and backoff jitter.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query term (required)"
        },
        "count": {
          "type": "integer",
          "description": "Number of search results to return (default: 10, max: 30)"
        },
        "timeout": {
          "type": "integer",
          "description": "Request timeout in seconds (default: 15)"
        },
        "max_retries": {
          "type": "integer",
          "description": "Maximum retries on failure (default: 3)"
        },
        "filter_spam": {
          "type": "boolean",
          "description": "Filter out low-quality or empty search results"
        },
        "no_color": {
          "type": "boolean",
          "description": "Disable ANSI color output"
        },
        "verbose": {
          "type": "boolean",
          "description": "Enable detailed debug logging"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "fetch_url_via_curl",
    "description": "Fetch content from a URL using curl with advanced options.",
    "parameters": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL to fetch."
        },
        "timeout": {
          "type": "integer",
          "description": "Request timeout in seconds (used as --max-time when max-time is default)."
        },
        "max_time": {
          "type": "integer",
          "description": "Maximum transfer time in seconds."
        },
        "connect_timeout": {
          "type": "integer",
          "description": "Connection timeout in seconds."
        },
        "user_agent": {
          "type": "string",
          "description": "Custom User-Agent header."
        },
        "output": {
          "type": "string",
          "description": "Output file path (default: LLM_OUTPUT or return body in tool result)."
        },
        "dump_header": {
          "type": "string",
          "description": "Output file path for HTTP response headers."
        },
        "cookie_file": {
          "type": "string",
          "description": "Path to cookie file for session management."
        },
        "method": {
          "type": "string",
          "description": "HTTP method (GET, POST, PUT, DELETE, PATCH, HEAD)."
        },
        "data": {
          "type": "string",
          "description": "Request body data for POST/PUT/PATCH."
        },
        "headers": {
          "type": "string",
          "description": "Comma-separated headers (e.g., \"Key: Val,Key2: Val2\")."
        },
        "follow_redirects": {
          "type": "boolean",
          "description": "Follow HTTP redirects."
        },
        "max_redirects": {
          "type": "integer",
          "description": "Maximum number of redirects."
        },
        "verify_ssl": {
          "type": "boolean",
          "description": "Verify SSL certificates (default: true)."
        },
        "compressed": {
          "type": "boolean",
          "description": "Request compressed response."
        },
        "silent": {
          "type": "boolean",
          "description": "Silent mode (less curl stderr)."
        },
        "verbose": {
          "type": "boolean",
          "description": "Verbose curl output to stderr."
        },
        "include": {
          "type": "boolean",
          "description": "Include HTTP response headers in the body output."
        },
        "retry": {
          "type": "integer",
          "description": "Number of retry attempts."
        },
        "retry_delay": {
          "type": "integer",
          "description": "Delay between retries in seconds."
        },
        "limit_rate": {
          "type": "string",
          "description": "Limit download rate (e.g., 100k, 1m)."
        },
        "proxy": {
          "type": "string",
          "description": "Proxy server URL."
        },
        "auth": {
          "type": "string",
          "description": "Authentication credentials (user:password or bearer token)."
        },
        "auth_type": {
          "type": "string",
          "description": "Authentication type (basic or bearer)."
        },
        "max_bytes": {
          "type": "integer",
          "description": "Abort if body exceeds this many bytes (default 10 MiB)."
        },
        "json_on_success": {
          "type": "boolean",
          "description": "If set, return JSON with body, http_code, and final_url on success."
        }
      },
      "required": [
        "url"
      ]
    }
  }
