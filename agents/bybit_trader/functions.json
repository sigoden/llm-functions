  {
    "name": "bybit_wbta",
    "description": "Market Trend Observatory v3.3 — Complete L2 Orderbook Microstructure, Trade Flow Analysis, Funding/OI Telemetry, 35+ Technical Indicators, and Multi-Factor Long/Short Signal Engine. Read-only telemetry tool.",
    "parameters": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Trading pair (e.g. BTCUSDT, ETHUSDT; default: BTCUSDT)"
        },
        "interval": {
          "type": "string",
          "description": "Kline timeframe: 1, 5, 15, 60, 240, D (default: 15)"
        },
        "delay": {
          "type": "integer",
          "description": "Refresh seconds between cycles in loop mode (default: 20)"
        },
        "use_tor": {
          "type": "boolean",
          "description": "Enable Tor SOCKS5 proxy routing"
        },
        "once": {
          "type": "boolean",
          "description": "Run a single analysis cycle and exit (default)"
        },
        "json_out": {
          "type": "boolean",
          "description": "Output raw JSON payload for LLM/system integration"
        },
        "no_color": {
          "type": "boolean",
          "description": "Disable ANSI color output"
        },
        "verbose": {
          "type": "boolean",
          "description": "Enable detailed debug logging"
        }
      }
    }
  },
  {
    "name": "bybit_core",
    "description": "Core V5 API driver for Bybit with session pooling, HMAC signing, failover domain routing, and automatic server time synchronization.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Test action: health_check, server_time, config"
