  {
    "name": "execute_command",
    "description": "Execute arbitrary shell command and return full output with complete runtime metadata.",
    "parameters": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Command to run (required)"
        },
        "timeout": {
          "type": "string",
          "description": "Duration for the command (e.g. 60s, 1m, 2h)"
        },
        "connect_timeout": {
          "type": "string",
          "description": "Connection timeout for curl commands (default: 10s)"
        },
        "max_time": {
          "type": "string",
          "description": "Max transfer time for curl commands (default: matches --timeout)"
        },
        "working_dir": {
          "type": "string",
          "description": "Working directory for the command (default: current dir)"
        },
        "env": {
          "type": "array",
          "description": "Extra environment variable (repeatable)",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "string",
          "description": "Shell to use: bash/sh/zsh (default: bash)"
        },
        "stdin": {
          "type": "string",
          "description": "Optional stdin content to pipe to command"
        },
        "retry": {
          "type": "integer",
          "description": "Number of retries on failure (default: 0)"
        },
        "retry_delay": {
          "type": "string",
          "description": "Delay between retries (default: 1s)"
        },
        "use_cache": {
          "type": "boolean",
          "description": "Enable result caching for identical command operations"
        },
        "no_color": {
          "type": "boolean",
          "description": "Disable ANSI colour output"
        },
        "strip_ansi": {
          "type": "boolean",
          "description": "Strip ANSI codes from command output before returning"
        },
        "verbose": {
          "type": "boolean",
          "description": "Show extra debug info (PATH, shell, env vars)"
        },
        "dry_run": {
          "type": "boolean",
          "description": "Show what would be executed without running"
        }
      },
      "required": [
        "command"
      ]
    }
  },
