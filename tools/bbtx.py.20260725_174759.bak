_realm: Optional[BybitRealm] = None
_realm_lock = threading.Lock()
def get_realm() -> BybitRealm:
    global _realm
    if _realm is None:
        with _realm_lock:
            if _realm is None:
                _realm = BybitRealm()
    return _realm
from typing import Optional, Literal, Any

def run(
    action: str,
    symbol: Optional[str] = None,
    side: Optional[Literal["Buy", "Sell"]] = None,
    qty: Optional[float] = None,
    price: Optional[float] = None,
    stop_loss: Optional[float] = None,
    take_profit: Optional[float] = None,
    leverage: Optional[int] = None,
    category: str = "linear",
    interval: str = "60",
    limit: int = 50,
    **kwargs: Any,
) -> Any:
    """Execute a trading action with the specified parameters."""
    pass
def execute_action(
    action: str,
    symbol: str = None,
    side: str = None,
    qty: float = None,
    price: float = None,
    category: str = "linear",
    stop_loss: float = None,
    take_profit: float = None,
    leverage: int = None,
    limit: int = None,
    interval: str = None,
    **kwargs,
) -> dict:
    bot = get_realm()
    logger.info(
        f"Executing Action: {action} | Symbol: {symbol} | Side: {side} | "
        f"Qty: {qty} | Price: {price}"
    )

    try:
        # ── Health & Account ─────────────────────────────────────────────────
        if action == "health_check":
            return bot.health_check()
        if action in ("get_wallet_balance", "check_balance"):
            return bot.get_wallet_balance(account_type=kwargs.get("account_type", "UNIFIED"))
        if action == "get_account_info":
            return bot.get_account_info()
        if action == "get_positions":
            return bot.get_positions(category=category, symbol=symbol)
        if action == "get_position_risk":
            return bot.get_position_risk(category=category, symbol=symbol)
        if action == "get_fee_rate":
            return bot.get_fee_rate(category=category, symbol=symbol)
        if action == "get_account_summary":
            return bot.get_account_summary()
        if action == "get_open_positions_summary":
            return bot.get_open_positions_summary(category=category)

        # ── Orders & Smart Trades ────────────────────────────────────────────
        if action == "place_smart_trade":
            return bot.place_smart_trade(
                symbol=symbol or "BTCUSDT",
                side=side or "Buy",
                qty=qty,
                price=price,
                stop_loss=stop_loss,
                take_profit=take_profit,
                leverage=leverage,
                **kwargs,
            )
        if action == "place_order":
            if not symbol or not side or qty is None:
                return {
                    "status": "error",
                    "msg": "symbol, side, and qty are required for place_order",
                }
            return bot.place_order(
                symbol=symbol,
                side=side,
                qty=qty,
                price=price,
                category=category,
                stop_loss=stop_loss,
                take_profit=take_profit,
                **kwargs,
            )
        if action == "amend_order":
            return bot.amend_order(
                symbol=symbol,
                qty=qty,
                price=price,
                stop_loss=stop_loss,
                take_profit=take_profit,
                category=category,
                **kwargs,
            )
        if action == "cancel_order":
            return bot.cancel_order(symbol=symbol, category=category, **kwargs)
        if action == "cancel_all_orders":
            return bot.cancel_all_orders(symbol=symbol, category=category)
        if action == "close_position":
            return bot.close_position(symbol=symbol, category=category)
        if action == "panic_close":
            return bot.panic_close(category=category)
        if action == "batch_place_orders":
            return bot.batch_place_orders(
                orders=kwargs.get("orders", []), category=category
            )
        if action == "set_leverage":
            return bot.set_leverage(
                symbol=symbol, leverage=leverage or 10, category=category
            )
        if action in ("set_trading_stop", "set_tp_sl"):
            return bot.set_trading_stop(
                symbol=symbol,
                stop_loss=stop_loss,
                take_profit=take_profit,
                category=category,
            )
        if action == "update_trailing_stop":
            return bot.set_trading_stop(
                symbol=symbol,
                trailing_stop=kwargs.get("trailing_stop_pct"),
                category=category,
            )
        if action == "bulk_update_tp_sl":
            return bot.bulk_update_tp_sl(
                category=category, tp=take_profit, sl=stop_loss
            )

        # ── Market Data ──────────────────────────────────────────────────────
        if action == "get_ticker":
            return bot.get_ticker(symbol=symbol, category=category)
        if action == "get_orderbook":
            return bot.get_orderbook(symbol=symbol, limit=limit, category=category)
        if action == "get_klines":
            return bot.get_klines(
                symbol=symbol, interval=interval, limit=limit, category=category
            )
        if action == "get_recent_trades":
            return bot.get_recent_trades(
                symbol=symbol, limit=limit, category=category
            )
        if action == "get_instruments_info":
            return bot.get_instruments_info(
                category=category, symbol=symbol, limit=limit
            )
        if action == "get_funding_rate":
            return bot.get_funding_rate(
                symbol=symbol, category=category, limit=limit
            )
        if action == "get_open_interest":
            return bot.get_open_interest(
                symbol=symbol, interval=interval, category=category, limit=limit
            )
        if action == "get_volatility_index":
            return bot.get_volatility_index(category=category)
        if action == "get_open_orders":
            return bot.get_open_orders(
                symbol=symbol, category=category, limit=limit
            )
        if action == "get_order_history":
            return bot.get_order_history(
                symbol=symbol, category=category, limit=limit
            )
        if action == "get_executions":
            return bot.get_executions(
                category=category, symbol=symbol, limit=limit
            )
        if action == "get_pnl_history":
            return bot.get_pnl_history(
                category=category, symbol=symbol, limit=limit
            )
        if action == "get_pnl_summary":
            return bot.get_pnl_summary(
                symbol=symbol, limit=limit, days=int(kwargs.get("days", 7))
            )

        # ── Observatory & Analytics (Delegated to bybit_wbta) ───────────────
        if action == "get_market_regime":
            return bot.get_market_regime(
                symbol=symbol or "BTCUSDT", interval=interval, **kwargs
            )
        if action in ("get_orderbook_analysis", "get_volume_at_price"):
            return bot.get_orderbook_analysis(
                symbol=symbol or "BTCUSDT", **kwargs
            )
        if action == "scan_scalping_opportunities":
            return bot.scan_scalping_opportunities(
                symbol=symbol or "BTCUSDT", interval=interval, **kwargs
            )
        if action == "scan_symbols":
            return bot.scan_symbols(
                symbols=kwargs.get("symbols", [symbol] if symbol else ["BTCUSDT"]),
                category=category,
            )
        if action.startswith("calculate_"):
            if action == "calculate_limit_micro_profit":
                return bot.calculate_micro_profit(
                    entry_price=float(kwargs.get("entry_price", price or 0)),
                    limit_price=float(kwargs.get("limit_price", price or 0)),
                    side=side or "Buy",
                    qty=float(qty or 0),
                )
            indicator_name = action.replace("calculate_", "").upper()
            return bot.calculate_indicator(
                name=indicator_name, symbol=symbol or "BTCUSDT",
                interval=interval, **kwargs,
            )

        # ── Miscellaneous ───────────────────────────────────────────────────
        if action == "get_journal":
            return {
                "status": "ok",
                "entries": bot.journal.get_entries(symbol=symbol, limit=limit),
            }
        if action == "check_risk_limit":
            return bot.check_risk_limit(
                symbol=symbol, qty=qty or 0, price=price or 0
            )
        if action == "export_trade_history":
            return bot.export_trade_history(
                symbol=symbol,
                filename=kwargs.get("filename", "trade_history.csv"),
            )
        if action == "send_telegram_alert":
            logger.info(f"ALERT: {kwargs.get('message', 'Alert triggered')}")
            return {"status": "ok", "msg": "Alert logged."}

        return {"status": "error", "msg": f"Action '{action}' is not supported."}

    except Exception as exc:
        logger.error(f"Execution error on action '{action}': {exc}", exc_info=True)
        return {"status": "error", "action": action, "msg": str(exc)}


