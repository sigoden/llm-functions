ENCOUNTERED_LINKS_FILE = CACHE_BASE_DIR / "encountered_links.txt"

MAX_DAILY_REQUESTS      = 100
MAX_REQUESTS_PER_MINUTE = 10
MAX_CACHE_MB            = 100

DOMAIN_BLACKLIST = re.compile(
