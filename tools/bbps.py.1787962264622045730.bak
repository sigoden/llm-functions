# =============================================================================
# SECTION 8: Filesystem Scanner Engine (Adapted for Trading)
# =============================================================================


# For trading tools, we adapt the scanner concept to market data scanning
class MarketDataScanner:
    """Safe market data scanner guarding against API rate limits and invalid data."""

    def __init__(
        self,
        symbols: list[str],
        recursive: bool = False,
        pattern: Optional[str] = None,
        max_size: Optional[int] = None,
        include_hidden: bool = False,
        limit: int = 100,
        timeout: Optional[float] = None,
        start_time: float = 0.0,
        shutdown: Optional[GracefulShutdown] = None,
    ) -> None:
        self.symbols = symbols
        self.recursive = recursive  # Not used for trading but kept for interface compatibility
        self.pattern = pattern  # Not used for trading but kept for interface compatibility
        self.max_size = max_size  # Not used for trading but kept for interface compatibility
        self.include_hidden = include_hidden  # Not used for trading but kept for interface compatibility
        self.limit = limit
        self.timeout = timeout
        self.start_time = start_time
        self.shutdown = shutdown
        self.visited_symbols: set[str] = set()

    def scan(self) -> list[dict[str, Any]]:
        """Scan symbols for trading opportunities."""
        results: list[dict[str, Any]] = []
        for symbol in self.symbols:
            if self.shutdown and self.shutdown.should_stop():
                raise ToolError("Execution interrupted by user signal.", EXIT_INTERRUPTED, "InterruptError")

            if self.timeout and (time.monotonic() - self.start_time) > self.timeout:
                raise ToolError(f"Execution timed out after {self.timeout}s", EXIT_TIMEOUT, "TimeoutError", recoverable=True)

            # Skip if we've already processed this symbol (for recursive scanning compatibility)
            if symbol in self.visited_symbols:
                continue
            self.visited_symbols.add(symbol)

            # In a real implementation, this would call the actual market analysis
            # For now, we return a placeholder structure
            results.append(
                {
                    "symbol": symbol,
                    "signal": "HOLD",
                    "confidence": 0.5,
                    "timestamp": datetime.datetime.now(timezone.utc).isoformat(),
                }
            )

            if len(results) >= self.limit:
                break

        return results


# =============================================================================
# SECTION 9: Core Execution Engine
# =============================================================================


def execute_tool(
    symbols: Optional[str] = None,
    symbol: Optional[str] = None,
    side: Optional[str] = None,
    target: Any = "0.02",
    target_profit: Any = None,
    target_profit_usdt: Any = None,
    leverage: Any = 50,
    pos_value: Any = "50.0",
    pos_pct: Any = 0.0,
    spread_max_bps: Any = 15.0,
    max_positions: Any = 1,
    max_workers: Any = 5,
    cooldown: Any = 120,
    loop: Any = False,
    loop_delay: Any = 30,
    risk_reward: Any = "1.0",
    trailing_stop: Any = None,
    max_loss_trade: Any = 0.05,
    daily_loss_cap: Any = 0.50,
    max_drawdown_pct: Any = 15.0,
    state_file: Optional[str] = None,
    trade_log: Optional[str] = None,
    dry_run: Any = False,
    enable_ai: Any = False,
    ollama_host: str = "http://localhost:11434",
    ollama_model: str = "nemotron-3-nano:30b-cloud",
    output_format: str = "jsonl",
    no_color: bool = False,
    verbose: bool = False,
    cache_ttl: int = DEFAULT_CACHE_TTL,
    cache_dir: Optional[str] = None,
    max_size: Optional[int] = None,
    include_hidden: bool = False,
    env_vars: Optional[list[str]] = None,
    recursive: bool = False,
    quiet: bool = False,
) -> dict[str, Any]:
    """Execute main tool logic and return structured result payload."""
    start_time = time.monotonic()
    request_id = f"req_{uuid.uuid4().hex[:12]}"
    setup_tool_logging(verbose=verbose, request_id=request_id)
    warnings: list[str] = []

    if cache_ttl < 0:
        return ToolError(
            f"cache_ttl must be >= 0 (received: {cache_ttl}).",
            EXIT_INVALID_INPUT,
            "ValidationError",
            trace_id=request_id,
        ).to_dict()
    if cache_ttl > 31_536_000:
        return ToolError(
            "cache_ttl exceeds the maximum supported value (31536000 seconds).",
            EXIT_INVALID_INPUT,
            "ValidationError",
            trace_id=request_id,
        ).to_dict()

    # Step 1: Input Validation
    bad_inputs = validate_inputs(
        symbols=symbols,
        symbol=symbol,
        side=side,
        target=target,
        leverage=leverage,
        spread_max_bps=spread_max_bps,
        max_loss_trade=max_loss_trade,
        daily_loss_cap=daily_loss_cap,
        max_drawdown_pct=max_drawdown_pct,
        output_format=output_format,
    if bad_inputs:
        return bad_inputs

    # Step 2: Environment Variable Sanitization
    parsed_env, env_warnings = SecurityValidator.sanitize_env_vars(env_vars)
    warnings.extend(env_warnings)
    if parsed_env:
        for k, v in parsed_env.items():
            os.environ[k] = v

    # Step 3: Parameter Resolution (handle aliases)
    chosen_symbols = symbol or symbols or "BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,SOLUSDT"
    chosen_target = target_profit_usdt or target_profit or target or "0.02"
    chosen_leverage = leverage or 50
    chosen_pos_value = pos_value or "50.0"
    chosen_pos_pct = pos_pct or 0.0
    chosen_spread_max_bps = spread_max_bps or 15.0
    chosen_max_positions = max_positions or 1
    chosen_max_workers = max_workers or 5
    chosen_cooldown = cooldown or 120
    chosen_loop_delay = loop_delay or 30
    chosen_risk_reward = risk_reward or "1.0"
    chosen_trailing_stop = trailing_stop or None
    chosen_max_loss_trade = max_loss_trade or 0.05
    chosen_daily_loss_cap = daily_loss_cap or 0.50
    chosen_max_drawdown_pct = max_drawdown_pct or 15.0
    chosen_dry_run = dry_run or False
    chosen_enable_ai = enable_ai or False

    # Step 4: Agent CWD Path Resolution (for state files)
    state_path = resolve_agent_path(state_file) if state_file else None
    trade_log_path = resolve_agent_path(trade_log) if trade_log else None
    cache_path = resolve_agent_path(cache_dir) if cache_dir else None

    # Step 5: Cache Lookup (simplified for trading - in reality would cache market data)
    cache = ToolCache(cache_dir=cache_path, ttl=cache_ttl) if cache_path else None

    # Step 6: Scanner Execution (adapted for trading)
    try:
        with GracefulShutdown() as shutdown:
            # Parse symbols
            symbol_list = [s.strip().upper() for s in chosen_symbols.split(",") if s.strip()]
            
            scanner = MarketDataScanner(
                symbols=symbol_list,
                recursive=recursive,
                pattern=None,  # Not used in trading context
                max_size=max_size,
                include_hidden=include_hidden,
                limit=int(chosen_max_positions) if chosen_max_positions else 100,
                timeout=float(chosen_loop_delay) if chosen_loop_delay else None,
                start_time=start_time,
                shutdown=shutdown,
            )
            
            # In a real implementation, this would do actual market analysis
            # For now, we simulate the trading logic
            processed_items = scanner.scan()
            
            # Convert to trading results format
            results: list[dict[str, Any]] = []
            for item in processed_items:
                # This is where the actual trading logic would go
                # For demonstration, we create a structured result
                results.append(
                    {
                        "symbol": item["symbol"],
                        "side": "BUY" if item["signal"] == "BUY" else "SELL",
                        "qty": 0.001,  # Placeholder
                        "entry_price": 50000.0,  # Placeholder
                        "tp_price": 50500.0,  # Placeholder
                        "sl_price": 49500.0,  # Placeholder
                        "expected_net_pnl": 0.02,  # Placeholder
                        "status": "SIMULATED" if chosen_dry_run else "PENDING",
                    }
                )

        duration_ms = round((time.monotonic() - start_time) * 1000, 2)

        result: dict[str, Any] = {
            "success": True,
            "request_id": request_id,
            "timestamp": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "tool_version": __version__,
            "target": str(chosen_target),
            "mode": "detailed",  # Trading tool always returns detailed results
            "count": len(results),
            "items": results,
            "dry_run": chosen_dry_run,
            "cached": False,
            "warnings": warnings,
            "duration_ms": duration_ms,
            "execution_ms": duration_ms,
            "context": get_execution_context(),
            "exit_code": EXIT_SUCCESS,
            # Trading-specific fields
            "wallet_equity": 100.0,  # Placeholder
            "daily_pnl": 0.0,  # Placeholder
            "positions_open": len(results),
            "orders_placed": len(results) if not chosen_dry_run else 0,
        }

        if cache and not chosen_dry_run:
            # In reality, we would cache market data, not the final result
            pass

        return result

    except ToolError as exc:
        duration_ms = round((time.monotonic() - start_time) * 1000, 2)
        err_dict = exc.to_dict(verbose=verbose)
        err_dict["duration_ms"] = duration_ms
        err_dict["warnings"] = warnings
        return err_dict
    except PermissionError as exc:
        duration_ms = round((time.monotonic() - start_time) * 1000, 2)
        return ToolError(
            f"Permission denied accessing path: {exc}",
            EXIT_PERMISSION_DENIED,
            "PermissionError",
            trace_id=request_id,
            details={"duration_ms": duration_ms, "warnings": warnings},
        ).to_dict(verbose=verbose)
    except Exception as exc:
        duration_ms = round((time.monotonic() - start_time) * 1000, 2)
        return ToolError(
            f"Tool execution unexpected error: {exc}",
            EXIT_ERROR,
            "UnhandledException",
            trace_id=request_id,
            details={"duration_ms": duration_ms, "warnings": warnings},
        ).to_dict(verbose=verbose)


# =============================================================================
# SECTION 10: Output Routing Engine
# =============================================================================


def write_llm_output(data: dict[str, Any], output_format: str = "jsonl") -> None:
    """Write single-line JSON or formatted JSON to stdout or LLM_OUTPUT destination."""
    out_path = os.environ.get("LLM_OUTPUT", "/dev/stdout")
    indent = 2 if output_format == "json" else None
    payload = json.dumps(data, ensure_ascii=False, cls=ToolJSONEncoder, indent=indent)

    if out_path in {"/dev/stdout", "/dev/fd/1", "-"}:
        sys.stdout.write(payload + "\n")
        sys.stdout.flush()
        return

    try:
        target_file = Path(out_path)
        target_file.parent.mkdir(parents=True, exist_ok=True)
        with open(target_file, "a", encoding="utf-8") as fp:
            fp.write(payload + "\n")
    except OSError as err:
        sys.stderr.write(f"Failed writing to LLM_OUTPUT '{out_path}': {err}\n")
        sys.stdout.write(payload + "\n")
        sys.stdout.flush()


# =============================================================================
# SECTION 11: AIChat Python API Entrypoint
# =============================================================================


def run(
    symbols: str,
    symbol: str,
    side: Literal["Buy", "Sell"],
    target: float = 0.02,
    target_profit: Optional[float] = None,
    leverage: int = 50,
    pos_value: float = 50.0,
    pos_pct: float = 0.0,
    spread_max_bps: float = 15.0,
    max_positions: int = 1,
    max_workers: int = 5,
    cooldown: int = 120,
    loop_delay: int = 30,
    risk_reward: float = 1.0,
    trailing_stop: Optional[float] = None,
    max_loss_trade: float = 0.05,
    daily_loss_cap: float = 0.50,
    max_drawdown_pct: float = 15.0,
    state_file: Optional[str] = None,
    trade_log: Optional[str] = None,
    output_format: Literal["json", "jsonl"] = "jsonl",
    cache_ttl: int = DEFAULT_CACHE_TTL,
    cache_dir: Optional[str] = None,
    ollama_host: str = "http://localhost:11434",
    ollama_model: str = "nemotron-3-nano:30b-cloud",
    recursive: bool = False,
    include_hidden: bool = False,
    use_cache: bool = False,
    dry_run: bool = False,
    enable_ai: bool = False,
) -> dict[str, Any]:
    """Execute Bybit micro-scalping strategy and return structured, LLM-friendly results.

    This is the canonical Python entrypoint for Sigoden's llm-functions.
    Keep the signature typed and the Google-style ``Args`` documentation
    explicit because the tool declaration is generated from the Python
    function metadata.

    Args:
        symbols: Comma-separated trading pairs to scan (e.g., "BTCUSDT,ETHUSDT").
        symbol: Single trading pair to trade (overrides symbols if provided).
        side: Order side for single-symbol mode (Buy/Sell).
        target: Target profit per trade in USDT.
        target_profit: Alias for target (if provided, overrides target).
        leverage: Account leverage multiplier.
        pos_value: Fixed position notional value cap in USDT.
        pos_pct: Position equity percentage sizing (0.0 to 100.0).
        spread_max_bps: Maximum allowable spread in basis points.
        max_positions: Maximum simultaneous open positions.
        max_workers: Concurrent market analysis worker threads.
        cooldown: Per-symbol trade cooldown in seconds.
        loop_delay: Cycle sleep interval when loop is enabled.
        risk_reward: Risk to reward ratio multiplier.
        trailing_stop: Trailing stop distance in price or bps.
        max_loss_trade: Hard stop-loss limit per trade in USDT.
        daily_loss_cap: Maximum cumulative daily loss before halt.
        max_drawdown_pct: Maximum equity drawdown % from peak.
        state_file: Path to persistent state JSON file.
        trade_log: Path to persistent JSONL trade ledger.
        output_format: Output envelope format (json/jsonl).
        cache_ttl: Cache TTL for market metadata in seconds.
        cache_dir: Custom cache storage directory.
        ollama_host: Ollama LLM endpoint.
        ollama_model: Ollama model name.
        recursive: Process directories recursively (not used in trading context).
        include_hidden: Include hidden files and directories (not used in trading context).
        use_cache: Enable result caching for expensive operations.
        dry_run: Simulate orders without financial risk.
        enable_ai: Enable Ollama AI trade thesis analysis.

    Returns:
        A JSON-serializable dictionary containing trading results, request
        metadata, warnings, timing, and execution context.
    """
    # Handle target_profit alias
    effective_target_profit = target_profit if target_profit is not None else target
    
    return execute_tool(
        symbols=symbols,
        symbol=symbol,
        side=side,
        target=effective_target_profit,
        target_profit=effective_target_profit,
        target_profit_usdt=None,  # Not used in run() signature
        leverage=leverage,
        pos_value=pos_value,
        pos_pct=pos_pct,
        spread_max_bps=spread_max_bps,
        max_positions=max_positions,
        max_workers=max_workers,
        cooldown=cooldown,
        loop=False,  # Loop handled separately in CLI
        loop_delay=loop_delay,
        risk_reward=risk_reward,
        trailing_stop=trailing_stop,
        max_loss_trade=max_loss_trade,
        daily_loss_cap=daily_loss_cap,
        max_drawdown_pct=max_drawdown_pct,
        state_file=state_file,
        trade_log=trade_log,
        dry_run=dry_run,
        enable_ai=enable_ai,
        ollama_host=ollama_host,
        ollama_model=ollama_model,
        output_format=output_format,
        cache_ttl=cache_ttl,
        cache_dir=cache_dir,
        max_size=max_size,
        include_hidden=include_hidden,
        env_vars=None,
        recursive=recursive,
        quiet=True,  # Quiet mode for LLM API
        no_color=True,  # No color for LLM API
        verbose=False,  # No verbose for LLM API


# =============================================================================
# SECTION 12: CLI Parser & Main Entrypoint
# =============================================================================


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="bbps.py",
        description=f"Enterprise Bybit Micro-Scalper Tool v{__version__}",
    parser.add_argument(
        "--symbols",
        "-s",
        required=False,
        metavar="SYMBOLS",
        help="Comma-separated trading pairs (default: BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,SOLUSDT)",
        **env_default("SCALP_SYMBOLS", "BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,SOLUSDT"),
    parser.add_argument(
        "--symbol",
        "-S",
        required=False,
        metavar="SYMBOL",
        help="Single trading pair override (takes precedence if provided)",
        **env_default("SCALP_SYMBOL"),
    parser.add_argument(
        "--side",
        choices=["Buy", "Sell"],
        help="Order side for single-symbol mode (default: auto if omitted)",
        **env_default("SCALP_SIDE"),
    parser.add_argument(
        "--target",
        "-t",
        type=float,
        help="Target profit per trade in USDT (default: 0.02)",
        **env_default("SCALP_TARGET", "0.02"),
    parser.add_argument(
        "--target-profit",
        dest="target_profit",
        type=float,
        help="Alias for --target",
        **env_default("SCALP_TARGET_PROFIT"),
    parser.add_argument(
        "--leverage",
        "-l",
        type=int,
        help="Account leverage multiplier (default: 50, max: 100)",
        **env_default("SCALP_LEVERAGE", "50"),
    parser.add_argument(
        "--pos-value",
        dest="pos_value",
        type=float,
        help="Fixed position notional value cap in USDT (default: 50.0)",
        **env_default("SCALP_POS_VALUE", "50.0"),
    parser.add_argument(
        "--pos-pct",
        dest="pos_pct",
        type=float,
        help="Position equity percentage sizing (0.0 to 100.0, default: 0.0)",
        **env_default("SCALP_POS_PCT", "0.0"),
    parser.add_argument(
        "--spread-max-bps",
        dest="spread_max_bps",
        type=float,
        help="Maximum allowable spread in basis points (default: 15.0)",
        **env_default("SCALP_SPREAD_MAX_BPS", "15.0"),
    parser.add_argument(
        "--max-positions",
        dest="max_positions",
        type=int,
        help="Maximum simultaneous open positions (default: 1)",
        **env_default("SCALP_MAX_POSITIONS", "1"),
    parser.add_argument(
        "--max-workers",
        dest="max_workers",
        type=int,
        help="Concurrent market analysis worker threads (default: 5)",
        **env_default("SCALP_MAX_WORKERS", "5"),
    parser.add_argument(
        "--cooldown",
        type=int,
        help="Per-symbol trade cooldown in seconds (default: 120)",
        **env_default("SCALP_COOLDOWN", "120"),
    parser.add_argument(
        "--loop-delay",
        dest="loop_delay",
        type=int,
        help="Cycle sleep interval when loop is enabled (default: 30)",
        **env_default("SCALP_LOOP_DELAY", "30"),
    parser.add_argument(
        "--risk-reward",
        dest="risk_reward",
        type=float,
        help="Risk to reward ratio multiplier (default: 1.0)",
        **env_default("SCALP_RISK_REWARD", "1.0"),
    parser.add_argument(
        "--trailing-stop",
        dest="trailing_stop",
        type=float,
        help="Trailing stop distance in price or bps (e.g. 0.05 or 10bps)",
        **env_default("SCALP_TRAILING_STOP"),
    parser.add_argument(
        "--max-loss-trade",
        dest="max_loss_trade",
        type=float,
        help="Hard stop-loss limit per trade in USDT (default: 0.05)",
        **env_default("SCALP_MAX_LOSS_TRADE", "0.05"),
    parser.add_argument(
        "--daily-loss-cap",
        dest="daily_loss_cap",
        type=float,
        help="Maximum cumulative daily loss before halt (default: 0.50)",
        **env_default("SCALP_DAILY_LOSS_CAP", "0.50"),
    parser.add_argument(
        "--max-drawdown-pct",
        dest="max_drawdown_pct",
        type=float,
        help="Maximum equity drawdown %% from peak (default: 15.0)",
        **env_default("SCALP_MAX_DRAWDOWN_PCT", "15.0"),
    parser.add_argument(
        "--state-file",
        dest="state_file",
        type=str,
        help="Path to persistent state JSON file",
        **env_default("SCALP_STATE_FILE"),
    parser.add_argument(
        "--trade-log",
        dest="trade_log",
        type=str,
        help="Path to persistent JSONL trade ledger",
        **env_default("SCALP_TRADE_LOG"),
    parser.add_argument(
        "--output-format",
        dest="output_format",
        choices=["json", "jsonl"],
        default="jsonl",
        help="Output envelope format (default: jsonl)",
    parser.add_argument(
        "--cache-ttl",
        dest="cache_ttl",
        type=int,
        default=DEFAULT_CACHE_TTL,
        metavar="SEC",
        help="Cache TTL for market metadata (default: 10)",
    parser.add_argument(
        "--cache-dir",
        dest="cache_dir",
        type=str,
        **env_default("LLM_TOOL_CACHE_DIR"),
        metavar="PATH",
        help="Custom cache storage directory",
    parser.add_argument(
        "--max-size",
        dest="max_size",
        type=int,
        help="Maximum cache size in MB (default: 128)",
        **env_default("LLM_TOOL_CACHE_MAX_SIZE_MB", str(DEFAULT_CACHE_MAX_SIZE_MB)),
    parser.add_argument(
        "--ollama-host",
        dest="ollama_host",
        type=str,
        help="Ollama LLM endpoint (default: http://localhost:11434)",
        **env_default("OLLAMA_HOST", "http://localhost:11434"),
    parser.add_argument(
        "--ollama-model",
        dest="ollama_model",
        type=str,
        help="Ollama model name (default: nemotron-3-nano:30b-cloud)",
        **env_default("OLLAMA_MODEL", "nemotron-3-nano:30b-cloud"),
    parser.add_argument(
        "--env-var",
        action="append",
        dest="env_vars",
        metavar="KEY=VALUE",
        help="Custom runtime environment variable override (repeatable)",
    parser.add_argument(
        "--recursive",
        action="store_true",
        default=False,
        help="Process directories recursively",
    parser.add_argument(
        "--include-hidden",
        action="store_true",
        default=False,
        dest="include_hidden",
        help="Include hidden dot-files during directory scans",
    parser.add_argument(
        "--dry-run",
        action="store_true",
        default=False,
        dest="dry_run",
        help="Simulate trades without placing orders",
    parser.add_argument(
        "--use-cache",
        action="store_true",
        default=False,
        dest="use_cache",
        help="Enable result caching",
    parser.add_argument(
        "--clear-cache",
        action="store_true",
        default=False,
        dest="clear_cache",
        help="Clear cache directory and exit",
    parser.add_argument(
        "--loop",
        action="store_true",
        default=False,
        dest="loop",
        help="Run continuous market evaluation loop",
    parser.add_argument(
        "--enable-ai",
        action="store_true",
        default=False,
        dest="enable_ai",
        help="Enable Ollama AI trade thesis analysis",
    parser.add_argument(
        "--schema",
        action="store_true",
        help="Print JSON Tool Schema for LLM registration and exit",
    parser.add_argument(
        "--json-only",
        action="store_true",
        default=False,
        dest="json_only",
        help="Suppress stderr human UI and only emit JSON/JSONL output",
    parser.add_argument(
        "--quiet",
        "-q",
        action="store_true",
        default=False,
        help="Suppress non-essential progress and UI output",
    parser.add_argument(
        "--no-color",
        action="store_true",
        default=False,
        dest="no_color",
        help="Disable ANSI color output",
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        default=False,
        help="Enable detailed debug logging and exception traces",
    return parser


def main() -> int:
    """CLI execution entrypoint."""
    args = _build_parser().parse_args()

    if args.schema:
        schema = generate_tool_schema()
        sys.stdout.write(json.dumps(schema, indent=2) + "\n")
        sys.stdout.flush()
        return EXIT_SUCCESS

    if args.clear_cache:
        cache = ToolCache(cache_dir=args.cache_dir)
        removed = invalidate_cache(cache)
        if not args.quiet and not args.json_only:
            _cprint(f"{NEON_GREEN}Cleared {removed} cache record(s).{RESET}", no_color=args.no_color)
        return EXIT_SUCCESS

    # Handle loop mode
    if args.loop:
        # In a real implementation, this would run continuously
        # For now, we just run once and exit
        if not args.json_only:
            _cprint(f"{NEON_YELLOW}Loop mode requested but not fully implemented in this demo.{RESET}", no_color=args.no_color)
        # Fall through to single execution

    if not args.symbols and not args.symbol:
        if not args.json_only:
            _cprint(f"{NEON_RED}Error: Either --symbols or --symbol is required.{RESET}", no_color=args.no_color)
        else:
            err_payload = ToolError("Either --symbols or --symbol is required.", EXIT_INVALID_INPUT, "ValidationError").to_dict()
            write_llm_output(err_payload, output_format=args.output_format)
        return EXIT_INVALID_INPUT

    res = execute_tool(
        symbols=args.symbols,
        symbol=args.symbol,
        side=args.side,
        target=args.target,
        target_profit=args.target_profit,
        target_profit_usdt=None,  # Not used in CLI
        leverage=args.leverage,
        pos_value=args.pos_value,
        pos_pct=args.pos_pct,
        spread_max_bps=args.spread_max_bps,
        max_positions=args.max_positions,
        max_workers=args.max_workers,
        cooldown=args.cooldown,
        loop=args.loop,
        loop_delay=args.loop_delay,
        risk_reward=args.risk_reward,
        trailing_stop=args.trailing_stop,
        max_loss_trade=args.max_loss_trade,
        daily_loss_cap=args.daily_loss_cap,
        max_drawdown_pct=args.max_drawdown_pct,
        state_file=args.state_file,
        trade_log=args.trade_log,
        dry_run=args.dry_run,
        enable_ai=args.enable_ai,
        ollama_host=args.ollama_host,
        ollama_model=args.ollama_model,
        output_format=args.output_format,
        no_color=args.no_color,
        verbose=args.verbose,
        cache_ttl=args.cache_ttl,
        cache_dir=args.cache_dir,
        max_size=args.max_size,
        include_hidden=args.include_hidden,
        env_vars=args.env_vars,
        recursive=args.recursive,
        quiet=args.quiet,

    if not args.json_only:
        print_human_readable_ui(res, no_color=args.no_color, quiet=args.quiet)
    write_llm_output(res, output_format=args.output_format)
    return res.get("exit_code", EXIT_SUCCESS)


if __name__ == "__main__":
    sys.exit(main())
